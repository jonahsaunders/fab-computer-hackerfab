	(text "Slot 1 (backplane J1) only. Backplane net -> RP2350B:\nA20 UART_RX = GPIO1 (UART0 RX, into the MCU): pump\nC20 UART_TX = GPIO0 (UART0 TX, from the MCU): pump\nA14 AUX1 = GPIO40: PUMP_DE, high = transmit\nA19 AUX2 = GPIO22: USB D+ (PIO-USB host)\nC18 AUX3 = GPIO23: USB D-\nA16 I2C0 SCL = GPIO5: ADS1115 at 0x48\nC16 I2C0 SDA = GPIO4"
		(exclude_from_sim no)
		(at 160.274 98.552 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ee14f6b0-02ac-567e-a1bc-c55f430c5264")
	)
